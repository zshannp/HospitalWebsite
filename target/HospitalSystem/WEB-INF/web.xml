<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
	<display-name>Archetype Created Web Application</display-name>

	<servlet>
		<servlet-name>adminServlet</servlet-name>
		<servlet-class>com.admin.servlet.AdminServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>userServlet</servlet-name>
		<servlet-class>com.user.servlet.UserServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>specialistServlet</servlet-name>
		<servlet-class>com.admin.servlet.specialist.SpecialistServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>doctorServlet</servlet-name>
		<servlet-class>com.doctor.servlet.DoctorServlet</servlet-class>
	</servlet>

	<servlet>
		<servlet-name>appointmentServlet</servlet-name>
		<servlet-class>com.user.servlet.AppointmentServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>adminServlet</servlet-name>
		<url-pattern>/adminServlet/login</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>adminServlet</servlet-name>
		<url-pattern>/adminServlet/logout</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>adminServlet</servlet-name>
		<url-pattern>/adminServlet/registerDoctor</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>adminServlet</servlet-name>
		<url-pattern>/adminServlet/updateDoctor</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>userServlet</servlet-name>
		<url-pattern>/userServlet/register</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>userServlet</servlet-name>
		<url-pattern>/userServlet/login</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>userServlet</servlet-name>
		<url-pattern>/userServlet/logout</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>userServlet</servlet-name>
		<url-pattern>/userServlet/changePassword</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>userServlet</servlet-name>
		<url-pattern>/userServlet/appointment</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>specialistServlet</servlet-name>
		<url-pattern>/specialistServlet/add</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>doctorServlet</servlet-name>
		<url-pattern>/doctorServlet/login</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>doctorServlet</servlet-name>
		<url-pattern>/doctorServlet/logout</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>doctorServlet</servlet-name>
		<url-pattern>/doctorServlet/updateStatus</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
		<servlet-name>appointmentServlet</servlet-name>
		<url-pattern>/appointmentServlet/addAppointment</url-pattern>
	</servlet-mapping>

</web-app>
